# ========================================================
# GitRepoReco — Variables d'environnement partagées
# ========================================================

# GitHub API Token (requis pour Analyse-github)
GITHUB_TOKEN=ghp_your_github_token_here

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=github_data
POSTGRES_ADMIN=postgres
POSTGRES_ADMIN_PASSWORD=postgres

# Utilisateur dédié Analyse-github (droits restreints DML)
COLLECTOR_DB_USER=github_collector
COLLECTOR_DB_PASSWORD=collector_password_change_me

# Paramètres de collecte GitHub (Analyse-github)
PAGE_SIZE=25
MAX_REPOSITORIES=0
POLL_INTERVAL_SECONDS=300
STAR_TIERS=100000,75000,50000,30000,20000,10000,5000,1000,500,100
LOG_LEVEL=INFO

